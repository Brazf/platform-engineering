terraform {
  required_providers {
    proxmox = {
      source  = "bpg/proxmox"
      version = "~> 0.112.0"
    }
  }
}

# Credenciais via env: PROXMOX_VE_ENDPOINT, PROXMOX_VE_API_TOKEN, PROXMOX_VE_INSECURE
provider "proxmox" {}

resource "proxmox_virtual_environment_vm" "vm" {
  node_name     = "{{ hcl .Node }}"
  name          = "{{ hcl .Name }}"
{{- if .Pool }}
  pool_id       = "{{ hcl .Pool }}"
{{- end }}
{{- if .Tags }}
  tags          = [{{ range $i, $t := .Tags }}{{ if $i }}, {{ end }}"{{ hcl $t }}"{{ end }}]
{{- end }}
{{- if .CloneVMID }}
  started       = {{ if .GPUMapping }}false{{ else }}true{{ end }}

  clone {
    vm_id = {{ .CloneVMID }}
    full  = true
  }
{{- else }}
  machine       = "q35"
  scsi_hardware = "virtio-scsi-pci"
  started       = false
{{- end }}

  cpu {
    cores = {{ .CPUCores }}
  }

  memory {
    dedicated = {{ .MemoryMB }}
  }

  disk {
    datastore_id = "{{ hcl .Storage }}"
    interface    = "scsi0"
    size         = {{ .DiskGB }}
    file_format  = "raw"
{{- if .CloneVMID }}
    discard      = "on"
    iothread     = true
{{- end }}
  }

  network_device {
    model  = "virtio"
    bridge = "{{ hcl .Bridge }}"
  }
{{- if .CloneVMID }}

  initialization {
    datastore_id = "{{ hcl .Storage }}"

    user_account {
      username = "{{ hcl .CloudInitUser }}"
{{- if .CloudInitPassword }}
      password = "{{ hcl .CloudInitPassword }}"
{{- end }}
{{- if .CloudInitSSHKeys }}
      keys     = [{{ range $i, $k := .CloudInitSSHKeys }}{{ if $i }}, {{ end }}"{{ hcl $k }}"{{ end }}]
{{- end }}
    }

    ip_config {
      ipv4 {
{{- if .StaticIP }}
        address = "{{ hcl .StaticIP }}"
        gateway = "{{ hcl .Gateway }}"
{{- else }}
        address = "dhcp"
{{- end }}
      }
    }
  }

  # Com agent habilitado e VM ligada, o provider bloqueia o apply até o
  # qemu-guest-agent responder (15 min por padrão); a imagem cloud não o tem.
  agent {
    enabled = false
  }
{{- else }}

  operating_system {
    type = "{{ hcl .OSType }}"
  }
{{- end }}
{{- if and .ISO (not .CloneVMID) }}

  cdrom {
    file_id   = "{{ hcl .ISO }}"
    interface = "ide2"
  }
  boot_order = ["ide2", "scsi0"]
{{- end }}
{{- if .GPUMapping }}

  hostpci {
    device  = "hostpci0"
    mapping = "{{ hcl .GPUMapping }}"
    pcie    = true
  }
{{- end }}
}

output "vmid" {
  value = proxmox_virtual_environment_vm.vm.vm_id
}
